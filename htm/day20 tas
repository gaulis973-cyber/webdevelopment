<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Order Summary</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #f5f5f5;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
    }
    .order-summary {
      background: #fff;
      padding: 20px;
      border-radius: 8px;
      width: 320px;
      box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }
    .order-summary h2 {
      margin-bottom: 20px;
      text-align: center;
    }
    .row {
      display: flex;
      justify-content: space-between;
      margin: 8px 0;
    }
    .total {
      font-weight: bold;
      font-size: 1.2em;
      border-top: 1px solid #ddd;
      padding-top: 10px;
    }
    .btn {
      display: block;
      width: 100%;
      padding: 12px;
      margin-top: 15px;
      text-align: center;
      background-color: orange;
      color: white;
      text-decoration: none;
      border-radius: 5px;
      font-weight: bold;
    }
    .link {
      display: block;
      margin-top: 10px;
      text-align: center;
      color: #555;
      text-decoration: none;
    }
  </style>
</head>
<body>
  <div class="order-summary">
    <h2>Order Summary</h2>
    <div class="row">
      <span>Subtotal</span>
      <span>Rs. 2400</span>
    </div>
    <div class="row">
      <span>Delivery Fee</span>
      <span>Rs. 100</span>
    </div>
    <div class="row total">
      <span>Total</span>
      <span>Rs. 2500</span>
    </div>
    <a href="#" class="btn">Proceed to Checkout</a>
    <a href="#" class="link">← Continue Shopping</a>
  </div>
</body>
</html>
